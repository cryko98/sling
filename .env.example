# Copy to .env for `vercel dev`, and set the same values in the Vercel
# dashboard (Settings -> Environment Variables) for the deployed site.
# Only FAL_KEY is required — everything else has a sane default.

# ---------------------------------------------------------------
# Required. Your fal.ai API key: https://fal.ai/dashboard/keys
# ---------------------------------------------------------------
FAL_KEY=


# ---------------------------------------------------------------
# THE CREDIT FENCE
#
# Generating costs real money (nano-banana is roughly $0.04 an image),
# so /api/meme rations it four ways. At the defaults below the worst
# possible day costs about $2.40 even if the site is being hammered.
#
# Raise MEME_DAILY_LIMIT when the tank is clearly too small; drop it
# (or set MEME_ENABLED=0) if the credit is running out too fast. No
# redeploy of the code is needed — only the env var.
# ---------------------------------------------------------------

# Kill switch. "0", "off" or "false" closes the forge immediately and
# the site says so instead of failing. Default on.
# MEME_ENABLED=1

# Images per UTC day, everyone combined. THE MAIN BUDGET DIAL. Default 60.
# MEME_DAILY_LIMIT=60

# Images per UTC day, per visitor IP. Default 6.
# MEME_IP_DAILY=6

# Burst limit: images per MEME_BURST_MIN minutes, per visitor IP.
# Stops one person emptying their whole daily allowance in ten seconds.
# Defaults: 2 per 3 minutes.
# MEME_BURST=2
# MEME_BURST_MIN=3

# How many generations may be running at the same time, site-wide.
# Default 4.
# MEME_INFLIGHT=4

# Images asked of fal per generation. A direct cost multiplier —
# leave it at 1 unless you want to pay double for a second take.
# MEME_IMAGES=1


# ---------------------------------------------------------------
# Optional: durable counters
#
# Without these, the daily counters live in the serverless instance's
# memory, so several warm instances each keep their own tally and the
# real total can overshoot MEME_DAILY_LIMIT. Attach a Vercel KV or
# Upstash Redis store and the two daily counters move there and become
# exact. Either variable pair works; nothing else changes.
# ---------------------------------------------------------------
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=


# ---------------------------------------------------------------
# THE CHARACTER REFERENCES
#
# Every generation ships these images to fal as the canon for what the
# bull looks like: the logo for his face, a full-body meme for his build
# and colouring. Comma separated, relative to the site root, or full
# URLs. fal fetches them itself, so they must be publicly reachable.
# ---------------------------------------------------------------
# MEME_REF_IMAGES=assets/logo.jpg,assets/stadium.jpg

# Only needed if the site itself is not publicly reachable at its own
# domain (e.g. the deployment sits behind Vercel Authentication) — point
# this at somewhere fal CAN read the images from.
# MEME_BASE_ORIGIN=https://www.theslingbull.fun


# ---------------------------------------------------------------
# Optional. Set to 0 to accept API calls that did not come from the
# site's own pages. Leave it on — it is free abuse filtering.
# ---------------------------------------------------------------
# MEME_STRICT_ORIGIN=1
